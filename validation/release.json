  "evidence_areas": [
    {
      "area": "Fourier transforms and effects",
      "level": "independent_reference",
      "files": [
        "tests/reference_transforms.rs",
        "tests/randomized_dsp.rs",
        "tests/correctness_regressions.rs"
      ],
      "scope": "STFT/ISTFT, phase vocoder, time stretch, resampling; boundary and filter differences have separate budgets."
    },
    {
      "area": "Wavelet transforms and inversion",
      "level": "independent_reference",
      "files": [
        "tests/reference_cqt.rs",
        "tests/reference_cqt_sweep.rs",
        "tests/reference_cqt_inverse.rs"
      ],
      "scope": "Full-rate CQT/VQT, independent SVD, localization and coefficient objectives; recursive parity and universal waveform recovery are not claimed."
    },
    {
      "area": "IIR and reassignment",
      "level": "independent_reference",
      "files": [
        "tests/reference_iir.rs",
        "tests/reference_reassignment.rs",
        "src/signal_processing/time_frequency.rs"
      ],
      "scope": "SciPy filter response/impulse and causal RMS; explicit nearest-grid reassigned magnitude."
    },
    {
      "area": "Spectral features",
      "level": "independent_reference",
      "files": [
        "tests/reference_spectral.rs",
        "tests/randomized_features.rs"
      ],
      "scope": "Mel/MFCC, inverse DCT, centroid/bandwidth/rolloff/flatness/contrast/RMS, HPSS and deltas."
    },
    {
      "area": "Magnitude, prediction and sequences",
      "level": "independent_reference",
      "files": [
        "tests/reference_core.rs",
        "tests/randomized_features.rs"
      ],
      "scope": "LPC/autocorrelation, dB/weighting/PCEN/mu-law, DTW/Viterbi; matching estimator/initial-state conventions."
    },
    {
      "area": "Rhythm",
      "level": "independent_and_analytic",
      "files": [
        "tests/reference_rhythm.rs"
      ],
      "scope": "Declared flux/tempogram/Fourier/PLP algorithms; exact pulse timing, silent behavior and beat endpoints."
    },
    {
      "area": "Phase recovery and decomposition",
      "level": "independent_and_objective",
      "files": [
        "tests/reference_recovery.rs"
      ],
      "scope": "Matched Griffin-Lim iterations; independently generated low-rank NMF targets, objective and gain checks; factors/phases are nonunique."
    },
    {
      "area": "Pitch and tuning",
      "level": "independent_and_analytic",
      "files": [
        "tests/pitch_correctness.rs",
        "tests/tuning_robustness.rs"
      ],
      "scope": "Librosa pitch fixture within documented cents allowance; voicing, analytic tones and scale/sweep tests."
    },
    {
      "area": "Audio workflows",
      "level": "independent_and_workflow",
      "files": [
        "tests/real_audio_workflows.rs",
        "tests/io_correctness.rs",
        "tests/fixtures/audio/manifest.json"
      ],
      "scope": "Three attributed four-second mono recordings, independent feature summaries, decode/resample/reconstruction/feature consistency and corruption errors."
    },
    {
      "area": "Channels, utilities and robustness",
      "level": "analytic_and_regression",
      "files": [
        "tests/time_domain_robustness.rs",
        "tests/utilities_magnitude_robustness.rs",
        "tests/feature_robustness.rs",
        "tests/transforms_features_robustness.rs",
        "tests/randomized_dsp.rs",
        "tests/randomized_features.rs"
      ],
      "scope": "Bounded deterministic invariants, malformed inputs, integer and numerical boundaries; not exhaustive input-space coverage."
    }
  ],
  "gates": [
    {
      "id": "manifest",
      "command": [
        "{python}",
        "scripts/validate_release.py",
        "--check"
      ]
    },
    {
      "id": "reference_runner",
      "command": [
        "{python}",
        "scripts/reference_benchmarks.py",
        "--self-test"
      ]
    },
    {
      "id": "format",
      "command": [
        "cargo",
        "fmt",
        "--all",
        "--",
        "--check"
      ]
    },
    {
      "id": "clippy",
      "command": [
        "cargo",
        "clippy",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ]
    },
    {
      "id": "debug",
      "command": [
        "cargo",
        "test",
        "--all-targets"
      ]
    },
    {
      "id": "release",
      "command": [
        "cargo",
        "test",
        "--release",
        "--all-targets"
      ]
    },
    {
      "id": "doctests",
      "command": [
        "cargo",
        "test",
        "--doc",
        "--",
        "--test-threads=2"
      ],
      "maximum_ignored": 20
    },
    {
      "id": "documentation",
      "command": [
        "cargo",
        "doc",
        "--no-deps"
      ],
      "env": {
        "RUSTDOCFLAGS": "-D warnings"
      }
    },
    {
      "id": "msrv",
      "command": [
        "cargo",
        "+1.85.0",
        "test",
        "--all-targets"
      ],
      "env": {
        "CARGO_TARGET_DIR": "target/msrv"
      }
    },
    {
      "id": "corpus",
      "command": [
        "{python}",
        "scripts/prepare_audio_corpus.py",
        "--verify"
      ]
    },
    {
      "id": "references",
      "command": [
        "{python}",
        "scripts/reference_benchmarks.py",
        "--check-fixtures",
        "--python",
        "{reference_python}"
      ]
    },
    {
      "id": "performance",
      "command": [
        "{python}",
        "scripts/performance_benchmarks.py",
        "run",
        "--repetitions",
        "15",
        "--warmup",
        "3",
        "--allocation-repetitions",
        "3",
        "--rss",
        "--output",
        "target/performance-final.json"
      ],
      "criterion": "Workloads complete with finite measurements and unchanged source; no wall-clock threshold."
    }
  ],
  "required_ci": {
    "workflow": ".github/workflows/ci.yml",
    "jobs": [
      "test",
      "release",
      "quality",
      "references",
      "performance"
    ],
    "platforms": [
      "Linux",
      "macOS",
      "Windows"
    ],
    "local_execution_does_not_verify_remote_ci": true
  },
  "remaining_independent_reference_gaps": [
    "FMT",
    "chroma/CENS/tonnetz",
    "formant, polynomial, entropy and subband features",
    "inverse-mel weighting and complete mel/MFCC-to-audio pipelines",
    "pitch shifting as an end-to-end effect",
    "segmentation/clustering and several harmonic utilities"
  ],
  "limitations": [
    "Coverage gaps are not claims that those APIs are untested or defective.",
    "Guarded inverse CQT is not regularization; finite coefficient improvement does not imply faithful or bounded-amplitude waveform recovery.",
    "Librosa conventions differ where explicitly documented; no full API/output parity claim.",
    "Performance reports are workload/machine measurements, not a realtime callback guarantee.",
    "The three-recording corpus has no annotated pitch, beat, onset, separation or transcript ground truth.",
    "Randomized and malformed-input sweeps are bounded; arithmetic dimension checks do not prevent every possible resource exhaustion.",
    "Twenty existing ignored documentation examples remain outside executed doctest coverage."
  ],
  "review_rules": [
    "Every new or changed public operation needs documented units, geometry, input/error behavior and a meaningful regression or reference/invariant check.",
    "Changes to fixture generators, error budgets, recorded inputs and release criteria must be reviewed with implementation changes.",
    "Numerical behavior/API changes require changelog notes and maintainer version review before publication.",
    "Maintain corpus attribution and source hashes; additions need explicit redistribution terms."
  ]
}
